generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// TENANT - The master table
// =====================================================
model Tenant {
  id            String    @id @default(cuid())
  subdomain     String    @unique
  businessName  String
  ownerName     String
  ownerPhone    String    @unique
  ownerEmail    String?
  plan          Plan      @default(CORE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Subscription lifecycle
  subscriptionStatus    String    @default("trial")
  subscriptionPlan      String?
  trialStartDate        DateTime  @default(now())
  trialEndDate          DateTime  @default(dbgenerated("NOW() + INTERVAL '7 days'"))
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  razorpayPaymentId     String?
  
  // Relations
  users         User[]
  services      Service[]
  customers     Customer[]
  appointments  Appointment[]
  transactions  Transaction[]
  settings      Settings?
}

enum Plan {
  CORE
  PRO
}

// =====================================================
// USERS - Staff and Admin logins
// =====================================================
model User {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name          String
  phone         String
  email         String?
  role          UserRole  @default(STAFF)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  appointments  Appointment[] @relation("StaffAppointments")
  transactions  Transaction[]
  
  @@unique([tenantId, phone])
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  RECEPTIONIST
}

// =====================================================
// SERVICES - What each parlor offers
// =====================================================
model Service {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name            String
  category        ServiceCategory
  description     String?
  price           Float
  durationMinutes Int
  color           String    @default("#6366F1")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  appointments    Appointment[]
}

enum ServiceCategory {
  HAIR
  SKIN
  BRIDAL
  NAILS
  SPA
  OTHER
}

// =====================================================
// CUSTOMERS
// =====================================================
model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name          String
  phone         String
  email         String?
  dateOfBirth   DateTime?
  gender        Gender?
  totalVisits   Int       @default(0)
  totalSpent    Float     @default(0)
  lastVisit     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  appointments  Appointment[]
  transactions  Transaction[]
  
  @@unique([tenantId, phone])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// =====================================================
// APPOINTMENTS
// =====================================================
model Appointment {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  
  staffId         String?
  staff           User?     @relation("StaffAppointments", fields: [staffId], references: [id])
  
  serviceId       String
  service         Service   @relation(fields: [serviceId], references: [id])
  
  appointmentDate DateTime
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  isWalkIn        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  transaction     Transaction?
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

// =====================================================
// TRANSACTIONS - Revenue tracking
// =====================================================
model Transaction {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  appointmentId   String?   @unique   // <-- FIXED: Added @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  
  staffId         String?
  staff           User?     @relation(fields: [staffId], references: [id])
  
  amount          Float
  paymentMode     PaymentMode
  transactionDate DateTime  @default(now())
  invoiceNumber   String    @unique
  notes           String?
  createdAt       DateTime  @default(now())
}

enum PaymentMode {
  CASH
  UPI
  CARD
  PACKAGE
}

// =====================================================
// SETTINGS - Per-tenant configuration
// =====================================================
model Settings {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  workingHours    Json      // { monday: {start, end}, ... }
  slotDuration    Int       @default(30) // minutes
  bufferTime      Int       @default(10) // minutes
  timezone        String    @default("Asia/Kolkata")
  currency        String    @default("INR")
  taxRate         Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
