generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                    String        @id @default(cuid())
  subdomain             String        @unique
  businessName          String
  ownerName             String
  ownerPhone            String        @unique
  ownerEmail            String?
  area                  String?
  city                  String?
  plan                  Plan          @default(CORE)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  subscriptionStatus    String        @default("trial")
  subscriptionPlan      String?
  trialStartDate        DateTime      @default(now())
  trialEndDate          DateTime      @default(dbgenerated("NOW() + INTERVAL '7 days'"))
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  razorpayPaymentId     String?
  appointments          Appointment[]
  customers             Customer[]
  services              Service[]
  settings              Settings?
  transactions          Transaction[]
  users                 User[]
}

model User {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  phone              String
  email              String?
  passwordHash       String?
  mustChangePassword Boolean       @default(false)
  role               UserRole      @default(STAFF)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[] @relation("StaffAppointments")
  transactions       Transaction[]

  @@unique([tenantId, phone])
  @@index([tenantId, isActive])
}

model Service {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  category        ServiceCategory
  description     String?
  price           Float
  durationMinutes Int
  color           String          @default("#6366F1")
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  appointments    Appointment[]

  @@index([tenantId, isActive])
}

model Customer {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  dateOfBirth  DateTime?
  gender       Gender?
  totalVisits  Int           @default(0)
  totalSpent   Float         @default(0)
  lastVisit    DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  transactions Transaction[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Appointment {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  staffId         String?
  staff           User?             @relation("StaffAppointments", fields: [staffId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  appointmentDate DateTime
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(CONFIRMED)
  notes           String?
  isWalkIn        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  transaction     Transaction?

  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
  @@index([tenantId, staffId])
}

model Transaction {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId   String?      @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  staffId         String?
  staff           User?        @relation(fields: [staffId], references: [id])
  amount          Float
  paymentMode     PaymentMode
  transactionDate DateTime     @default(now())
  invoiceNumber   String       @unique
  notes           String?
  createdAt       DateTime     @default(now())

  @@index([tenantId, transactionDate])
}

model Settings {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workingHours Json
  slotDuration Int      @default(30)
  bufferTime   Int      @default(10)
  timezone     String   @default("Asia/Kolkata")
  currency     String   @default("INR")
  taxRate      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Plan {
  CORE
  PRO
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  RECEPTIONIST
}

enum ServiceCategory {
  HAIR
  SKIN
  BRIDAL
  NAILS
  SPA
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  CONFIRMED
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMode {
  CASH
  UPI
  CARD
  PACKAGE
}
